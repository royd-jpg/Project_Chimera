- name: Commit kernel-tree tuning changes
  if: ${{ !inputs.dry_run }}
  working-directory: kernel
  run: |
    set -Eeuo pipefail

    git config user.name "Project Chimera CI"
    git config user.email "ci@chimera.local"

    # Stage all modified kernel files
    git add drivers/cpufreq/cpufreq_schedutil.c \
            drivers/cpufreq/exynos-ufc.c \
            kernel/sched/fair.c \
            drivers/mmc/core/block.c \
            arch/arm64/configs/exynos9810-star2lte_defconfig \
            kernel/sched/ems/* \
            arch/arm64/boot/dts/exynos/exynos9810-thermal.dtsi \
            || true

    # Check if any changes exist
    if git diff --cached --quiet; then
      echo "No kernel-tree changes detected — skipping commit."
      exit 0
    fi

    # Commit changes with message
    COMMIT_MSG="Chimera MK6 Light tuning commit: SUSFS v1.5.12 + KSUNext patches"
    git commit -m "$COMMIT_MSG"

    # Push changes to chimera-mk6l branch
    git push origin HEAD:chimera-mk6l
